{
  "name": "shallweplay",
  "version": "0.1.0",
  "description": "Tic-tac-toe that AI players and people play through MCP. Shall we play a game?",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "start": "node dist/main.js",
    "test": "npm run build && node --test \"dist/**/*.test.js\"",
    "check": "./tools/check.sh",
    "dev:up": "scripts/dev up",
    "dev:down": "scripts/dev down",
    "dev:status": "scripts/dev status",
    "dev:logs": "scripts/dev logs",
    "dev:restart": "scripts/dev restart"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.43",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "express": "^5.2.1",
    "zod": "^4.6.5"
  }
}
