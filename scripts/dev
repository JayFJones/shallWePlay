#!/usr/bin/env bash
# Runs the WOPR server in the background so a terminal stays free for the
# Claude Code windows that play on it. The pid and log live in .dev/, which
# git ignores.
#
#   scripts/dev up        build, start, and wait until it answers
#   scripts/dev down      stop it
#   scripts/dev status    say whether it is running
#   scripts/dev logs      follow the log
#   scripts/dev restart   down, then up
set -euo pipefail
cd "$(dirname "$0")/.."

PORT="${PORT:-5171}"
URL="http://localhost:$PORT"
PID_FILE=.dev/wopr.pid
LOG_FILE=.dev/wopr.log

running() { [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; }
answering() { curl -s -o /dev/null --max-time 1 "$URL/api/state"; }

up() {
  if running; then
    echo "WOPR is already running (pid $(cat "$PID_FILE")) at $URL"
    return
  fi
  # Something else on the port would make the new server die at once, and
  # the only clue would be in the log.
  if curl -s -o /dev/null --max-time 1 "$URL"; then
    echo "Port $PORT is in use by another process. Stop it, or run with PORT=<n>." >&2
    exit 1
  fi
  mkdir -p .dev
  npm run --silent build
  PORT="$PORT" nohup node dist/main.js >>"$LOG_FILE" 2>&1 &
  echo $! >"$PID_FILE"

  for _ in $(seq 50); do
    if answering; then
      echo "WOPR is up (pid $(cat "$PID_FILE"))."
      echo "  play:   $URL"
      echo "  admin:  $URL/admin"
      echo "  MCP:    $URL/mcp"
      echo "  add it: claude mcp add --transport http wopr $URL/mcp"
      return
    fi
    if ! running; then break; fi
    sleep 0.2
  done
  echo "WOPR did not start. Last lines of $LOG_FILE:" >&2
  tail -n 20 "$LOG_FILE" >&2
  rm -f "$PID_FILE"
  exit 1
}

down() {
  if ! running; then
    echo "WOPR is not running."
    rm -f "$PID_FILE"
    return
  fi
  local pid
  pid="$(cat "$PID_FILE")"
  kill "$pid"
  for _ in $(seq 50); do
    kill -0 "$pid" 2>/dev/null || break
    sleep 0.1
  done
  rm -f "$PID_FILE"
  echo "WOPR stopped."
}

status() {
  if running; then
    echo "WOPR is running (pid $(cat "$PID_FILE")) at $URL"
  else
    echo "WOPR is not running."
  fi
}

case "${1:-}" in
  up) up ;;
  down) down ;;
  status) status ;;
  logs) mkdir -p .dev && touch "$LOG_FILE" && tail -n 50 -f "$LOG_FILE" ;;
  restart) down && up ;;
  *) echo "usage: scripts/dev up|down|status|logs|restart" >&2; exit 2 ;;
esac
